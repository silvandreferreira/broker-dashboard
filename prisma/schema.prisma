// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accessApproved    Boolean   @default(false)
  accessRequestedAt DateTime  @default(now())
  accessApprovedAt  DateTime?

  accounts Account[]
  sessions Session[]

  files UploadedFile[]

  pushSubscriptions PushSubscription[]
  alertWatches      AlertWatch[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UploadedFile {
  id         String   @id @default(cuid())
  fileName   String
  uploadedAt DateTime @default(now())
  isActive   Boolean  @default(false)
  /// Data de geração do relatório XTB ("Data as of report generated").
  reportDate DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  assets    Asset[]
  documents BrokerDocument[]
}

/// Documento de uma corretora dentro de uma entrada (UploadedFile).
/// Uma entrada pode juntar um relatório XTB e um ou mais CSV da Trading 212.
model BrokerDocument {
  id         String    @id @default(cuid())
  /// "XTB" ou "T212"
  broker     String
  fileName   String
  uploadedAt DateTime  @default(now())
  /// XTB: data do relatório. T212: data da importação.
  reportDate DateTime?
  /// T212: ordens de compra/venda do CSV (ver lib/t212Parser.ts); as posições são recalculadas
  /// a partir da união das ordens de todos os CSV da entrada (sem duplicados, pelo ID da ordem).
  transactions Json?

  fileId String
  file   UploadedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  assets Asset[]
}

model Asset {
  id            String  @id @default(cuid())
  ticker        String
  name          String?
  category      String?
  type          String
  quantity      Float
  avgPrice      Float?
  investedValue Float
  currentValue  Float
  profitLoss    Float
  year          Int?
  /// Data/hora de abertura do lote (Open time UTC).
  openedAt      DateTime?
  /// Produto XTB: "My Trades" ou "Investment Plan" (null em uploads antigos = My Trades).
  product       String?
  /// "XTB" ou "T212" (null em uploads antigos = XTB).
  broker        String?

  fileId String
  file   UploadedFile @relation(fields: [fileId], references: [id])

  documentId String?
  document   BrokerDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
}
/// Cache de fechos diários do Yahoo Finance, já convertidos para EUR.
/// Uma linha por símbolo; `closes` = [["YYYY-MM-DD", fecho], ...] ordenado por data.
model PriceHistory {
  symbol    String   @id
  currency  String
  fromDate  DateTime
  closes    Json
  fetchedAt DateTime @default(now())
}


/// Subscrição Web Push de um dispositivo (app instalada no telemóvel, browser, ...).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// ETFs vigiados pelos alertas de queda (criados a partir do último ficheiro carregado).
model AlertWatch {
  id        String   @id @default(cuid())
  ticker    String
  name      String?
  enabled   Boolean  @default(true)
  /// Quando foi enviado o alerta da queda atual (null = ainda não / já recuperou).
  alertedAt DateTime?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticker])
}

/// Registo de cada verificação agendada (evita enviar duas vezes no mesmo horário).
model AlertRun {
  /// "YYYY-MM-DD HH" na hora de Lisboa
  slot    String   @id
  ranAt   DateTime @default(now())
  summary Json?
}

/// Métricas fundamentais (Finnhub /stock/metric) por ação do S&P 500, atualizadas pelo cron diário.
model StockFundamentals {
  symbol    String   @id
  name      String
  sector    String
  industry  String?
  /// Métricas atuais selecionadas: { peTTM: 27.2, roiTTM: 59.5, ... }
  metrics   Json?
  /// Séries anuais e trimestrais: { annual: { pe: [{period, v}], ... }, quarterly: {...} }
  series    Json?
  error     String?
  fetchedAt DateTime @default(now())
}

/// Dados de detalhe (perfil, analistas, resultados, insiders) em cache, pedidos ao abrir a ação.
model StockDetailCache {
  symbol    String   @id
  data      Json
  fetchedAt DateTime @default(now())
}
